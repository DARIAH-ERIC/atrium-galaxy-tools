<tool name="atrium_pdf_text_extraction" id="atrium_pdf_text_extraction" version="1.0.0" profile="22.05">
  <description>Extracts text from PDF files into a page based JSON format</description>
  <requirements>
    <requirement version="3.12.3" type="package">python</requirement>
    <requirement version="6.1.3" type="package">pypdf</requirement>
    <requirement version="17.7.0" type="package">ocrmypdf</requirement>
    <requirement version="5.5.2" type="package">tesseract</requirement>
    <requirement version="2.8.4" type="package">fpdf2</requirement>
  </requirements>
  <version_command><![CDATA[echo "1.0.0"]]></version_command>
  <command><![CDATA[python
'$__tool_directory__/atrium_pdf_text_extraction.py'
#for pdf in $pdfs#
--pdf
'$pdf'
#end for
--json
'$json'
#if $ocr == "set"
 --ocr
#end if]]></command>
  <inputs>
    <param name="pdfs" type="data" optional="false" label="PDF file from which to extact text" help="" format="pdf" multiple="true"/>
    <param name="ocr" type="select" label="Should we perform OCR before extracting text?" help="" display="radio">
      <option value="set">Yes</option>
      <option value="notset" selected="true">No</option>
    </param>
  </inputs>
  <outputs>
    <data name="json" format="json" label="json" hidden="false"/>
  </outputs>
  <tests>
    <test>
      <output name="json" value="json_sample" compare="diff" lines_diff="0"/>
      <param name="pdfs" value="pdf_sample"/>
      <param name="ocr" value="notset"/>
    </test>
    <test>
      <output name="json" value="json_ocr_sample" compare="diff" lines_diff="0"/>
      <param name="pdfs" value="pdf_sample"/>
      <param name="ocr" value="set"/>
    </test>
  </tests>
  <help><![CDATA[
 A script for extracting text from PDF files and storing it into a simple JSON structure which can also store metadata and section (or annotation) information.
  ]]></help>
  <citations>
    <!-- leave the ToolFactory citation for now so we pass the linter -->
    <citation type="doi">10.1093/bioinformatics/bts573</citation>
  </citations>
</tool>

