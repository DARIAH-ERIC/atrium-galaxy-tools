<tool name="easyocr" id="easyocr" version="1.0.0" profile="22.05">
  <description>Calls a GATE Cloud Service</description>
  <requirements>
    <requirement version="3.12.3" type="package">python</requirement>
    <requirement version="1.7.2" type="package">easyocr</requirement>
  </requirements>
  <version_command><![CDATA[echo "1.0.0"]]></version_command>
  <command><![CDATA[python
'$__tool_directory__/ocr.py'
'$input'
'$output'
#if $paragraphs
--paragraphs
#end if
]]></command>
  <inputs>
    <param name="input" type="data" optional="false" label="Image to process" help="" format="jpg,png" multiple="false"/>
    <param name="paragraphs" type="boolean" optional="true" label="Paragraph mode" help="If true, the OCR will attempt to group text into paragraphs. If false, it will treat each line of text separately." checked="true"/>
    <param name="gpu" type="boolean" optional="true" label="Use GPU" help="If true, the OCR will use the GPU if available. If false, it will use the CPU." checked="false"/>
  </inputs>
  <outputs>
    <data name="output" format="json" label="json" hidden="false"/>
  </outputs>
  <tests>
    <test>
      <output name="output" value="advert-paragraphs.json" compare="diff" lines_diff="0"/>
      <param name="input" value="advert.png"/>
    </test>
    <test>
      <output name="output" value="advert.json" compare="diff" lines_diff="0"/>
      <param name="paragraphs" value="false"/>
      <param name="input" value="advert.png"/>
    </test>
  </tests>
  <help><![CDATA[
Uses EasyOCR to extract text from an image. The output is a JSON file containing the extracted text and bounding boxes for each detected text region.
  ]]></help>
  <citations>
    <!-- leave the ToolFactory citation for now so we pass the linter -->
    <citation type="doi">10.1093/bioinformatics/bts573</citation>
  </citations>
</tool>

